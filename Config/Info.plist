<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keys Xcode can't generate from build settings. The rest of Info.plist is generated. -->
	<!-- Shows Documents (the clip recorder's Corpus folder) in the Files app. -->
	<key>UIFileSharingEnabled</key>
	<true/>
</dict>
</plist>
